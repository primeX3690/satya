# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Email privacy - the email is NEVER stored in plaintext in the database.
# EMAIL_HASH_SECRET: keys a one-way HMAC used only for exact-match lookup
#   (login, duplicate-signup checks). Cannot be reversed.
# EMAIL_ENCRYPTION_SECRET: keys a reversible AES-256-GCM encryption used only
#   when the real address is genuinely needed (e.g. sending an OTP).
#   Must be exactly 64 hex characters (32 bytes). Generate both with:
#     openssl rand -hex 32
EMAIL_HASH_SECRET=change-this-to-a-random-hex-string
EMAIL_ENCRYPTION_SECRET=change-this-to-a-64-char-hex-string

# Database (SQLite file path, created automatically)
DATABASE_PATH=./data/satyanet.sqlite

# OTP delivery
# EMAIL_OTP_DELIVERY: "console" logs to the server terminal (default, no setup needed)
#                     "gmail" sends real email via a Gmail account + App Password
#                     "smtp" sends real email via any SMTP provider (SendGrid, Mailgun, etc.)
# SMS_OTP_DELIVERY:   "console" (default) or "twilio" for real SMS
OTP_TTL_MINUTES=10

EMAIL_OTP_DELIVERY=console
EMAIL_FROM="SatyaNet <no-reply@satyanet.local>"
# Required if EMAIL_OTP_DELIVERY=gmail:
#   1. Turn on 2-Step Verification on the Gmail account: https://myaccount.google.com/security
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Use that 16-character app password below (NOT your normal Gmail password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Required if EMAIL_OTP_DELIVERY=smtp:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

SMS_OTP_DELIVERY=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Media content-safety (blocks explicit/pornographic images & videos on upload)
# mode = "mock" always allows media through - fine for local dev ONLY.
# mode = "sightengine" runs real AI content checks (free tier available).
#   Sign up: https://sightengine.com/  (free plan includes a monthly quota)
# IMPORTANT: this only detects general adult/explicit content. It is NOT a
# child-sexual-abuse-material (CSAM) detector - see docs/content-safety.md
# for the specialized, legally-required tooling needed before public launch.
MEDIA_MODERATION_MODE=mock
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# IPFS
# mode = "mock" stores a local content-addressed hash without a real IPFS node (default)
# mode = "pinata" uses Pinata's hosted pinning service - easiest real option, free tier
# mode = "http" talks to your own IPFS node (local Kubo daemon)
IPFS_MODE=mock
IPFS_API_URL=http://127.0.0.1:5001
PINATA_JWT=
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# Admin bootstrap (first run only, see docs/deployment.md)
ADMIN_BOOTSTRAP_EMAIL=admin@satyanet.local
ADMIN_BOOTSTRAP_PASSWORD=change-this-password

