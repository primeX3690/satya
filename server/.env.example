# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Email privacy - the email is NEVER stored in plaintext in the database.
# EMAIL_HASH_SECRET: keys a one-way HMAC used only for exact-match lookup
#   (login, duplicate-signup checks). Cannot be reversed.
# EMAIL_ENCRYPTION_SECRET: keys a reversible AES-256-GCM encryption used only
#   when the real address is genuinely needed (e.g. sending an OTP).
#   Must be exactly 64 hex characters (32 bytes). Generate both with:
#     openssl rand -hex 32
EMAIL_HASH_SECRET=change-this-to-a-random-hex-string
EMAIL_ENCRYPTION_SECRET=change-this-to-a-64-char-hex-string

# Database (SQLite file path, created automatically)
DATABASE_PATH=./data/satyanet.sqlite

# OTP provider
# mode = "console" logs OTPs to the server console (default, no external account needed)
# mode = "twilio" sends real SMS via Twilio (fill the TWILIO_* values below)
OTP_MODE=console
OTP_TTL_MINUTES=10
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# IPFS
# mode = "mock" stores a local content-addressed hash without a real IPFS node (default)
# mode = "http" talks to a real IPFS HTTP API (local node or Infura/Pinata gateway)
IPFS_MODE=mock
IPFS_API_URL=http://127.0.0.1:5001

# Admin bootstrap (first run only, see docs/deployment.md)
ADMIN_BOOTSTRAP_EMAIL=admin@satyanet.local
ADMIN_BOOTSTRAP_PASSWORD=change-this-password
